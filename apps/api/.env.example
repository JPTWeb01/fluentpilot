# Used when running the API locally without Docker (uvicorn from apps/api).
# Copy to apps/api/.env.
#
# If running via `docker compose` instead, that stack is configured from the
# repo-root .env.example — see there.

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://fluentpilot:changeme@localhost:5432/fluentpilot
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173
