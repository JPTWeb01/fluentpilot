# Used when running the API locally without Docker (uvicorn from apps/api).
# Copy to apps/api/.env.
#
# If running via `docker compose` instead, that stack is configured from the
# repo-root .env.example — see there.

ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://fluentpilot:changeme@localhost:5432/fluentpilot
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173

# AI providers — all optional, leave unset to skip that provider. With none set,
# only Ollama is used (and only works if a local Ollama daemon is running).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Piper — local/offline TTS-only fallback, no key needed, but the voice model
# must be downloaded first: see services/ai README.
PIPER_VOICE=en_US-lessac-medium
