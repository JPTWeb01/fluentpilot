# Used by docker-compose (infra/docker/docker-compose.yml).
# Copy to .env at the repo root before running `docker compose up`.

# ---- General ----
ENVIRONMENT=development

# ---- Postgres ----
POSTGRES_USER=fluentpilot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fluentpilot

# ---- Auth ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- AI providers ----
# All optional, leave unset to skip that provider. With none set, only Ollama
# is used (and only works if a local Ollama daemon is running).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
